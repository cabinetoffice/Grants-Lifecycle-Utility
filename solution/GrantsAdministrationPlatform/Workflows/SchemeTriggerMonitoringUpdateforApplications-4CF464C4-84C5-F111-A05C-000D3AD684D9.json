            "parameters": {
              "entityName": "gap_applications",
              "fetchXml": "<fetch distinct=\"true\">\n  <entity name=\"gap_application\">\n\n    <attribute name=\"gap_applicationid\" />\n    <attribute name=\"gap_gapid\" />\n    <attribute name=\"gap_currentstage\" />\n\n    <filter type=\"and\">\n\n      <condition\n        attribute=\"gap_scheme\"\n        operator=\"eq\"\n        value=\"@{triggerOutputs()?['body/gap_schemeid']}\" />\n\n      <filter type=\"or\">\n        <condition attribute=\"gap_currentstage\" operator=\"eq\" value=\"Monitoring Draft\" />\n        <condition attribute=\"gap_currentstage\" operator=\"eq\" value=\"Error (Monitoring Draft)\" />\n        <condition attribute=\"gap_currentstage\" operator=\"eq\" value=\"Monitoring\" />\n      </filter>\n\n      <filter type=\"or\">\n\n        <!-- No Monitoring Structure -->\n        <condition\n          entityname=\"ms\"\n          attribute=\"gap_monitoringstructureid\"\n          operator=\"null\" />\n\n        <!-- Monitoring Structure exists but has never been versioned -->\n        <condition\n          entityname=\"ms\"\n          attribute=\"gap_sourcetemplateversion\"\n          operator=\"null\" />\n\n        <!-- Monitoring Structure exists but is stale -->\n        <condition\n          entityname=\"ms\"\n          attribute=\"gap_sourcetemplateversion\"\n          operator=\"ne\"\n          value=\"@{outputs('Get_Monitoring_Template')?['body/gap_templateversion']}\" />\n\n      </filter>\n\n    </filter>\n\n    <link-entity\n      name=\"gap_monitoringstructure\"\n      from=\"gap_monitoringstructureid\"\n      to=\"gap_monitoringstructure\"\n      alias=\"ms\"\n      link-type=\"outer\">\n\n      <attribute name=\"gap_monitoringstructureid\" />\n      <attribute name=\"gap_sourcetemplateversion\" />\n\n    </link-entity>\n\n  </entity>\n</fetch>"
